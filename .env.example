# POS Pro — Web-only configuration
# Copy to .env in development or configure these values in your hosting dashboard.

# development | production
POS_ENV=development

# Local development (SQLite): leave empty.
# Production example:
# POS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
POS_DATABASE_URL=

# Required in production (32+ characters)
POS_JWT_SECRET=

# Initial admin account (required on first production bootstrap)
POS_ADMIN_LOGIN=admin
POS_ADMIN_NAME=المدير
POS_ADMIN_PASSWORD=

# Optional. Same-origin hosting normally does not need extra origins.
# Example: https://pos.example.com
POS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

POS_TOKEN_HOURS=12
POS_SCRYPT_N=32768
POS_DB_POOL_SIZE=10
POS_DB_MAX_OVERFLOW=20
POS_DB_POOL_TIMEOUT=10

POS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# On Vercel, generated deployment hosts are detected automatically.
# For a custom domain, add the exact hostname here.
# POS_ALLOWED_HOSTS=yourdomain.com
